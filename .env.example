# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/expenseflow

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=change_me_too

# ─── Bcrypt ───────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ETHEREAL_USER=
ETHEREAL_PASS=

# ─── Client ───────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Cloudinary (default receipt/image storage) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=2
MAX_UPLOAD_SIZE_MB=10

# ─── Redis / BullMQ (background jobs: OCR, email, reports) ────────────────────
REDIS_URL=redis://127.0.0.1:6379
DISABLE_WORKERS=false

# ─── AWS S3 (optional alternate receipt storage) ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── AI Assistant (optional) ───────────────────────────────────────────────────
OPENAI_API_KEY=
